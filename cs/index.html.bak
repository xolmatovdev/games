<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Counter-Strike 1.6 - Web Edition (de_dust2)</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }
    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #0d0f12;
      font-family: 'Courier New', Courier, monospace, Tahoma, sans-serif;
      color: #e0e0e0;
    }

    #game-container {
      position: relative;
      width: 100vw;
      height: 100vh;
    }

    canvas#c {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* CS 1.6 Classic HUD */
    #hud {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 10;
    }

    /* Dynamic Crosshair */
    #crosshair {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
      width: 44px;
      height: 44px;
    }
    .ch-bar {
      position: absolute;
      background: rgba(0, 255, 60, 0.95);
      box-shadow: 0 0 2px rgba(0, 0, 0, 0.9);
      transition: all 0.05s ease-out;
    }
    #ch-top { width: 2px; height: 11px; top: 2px; left: 21px; }
    #ch-bottom { width: 2px; height: 11px; bottom: 2px; left: 21px; }
    #ch-left { width: 11px; height: 2px; left: 2px; top: 21px; }
    #ch-right { width: 11px; height: 2px; right: 2px; top: 21px; }
    #ch-dot { width: 2px; height: 2px; top: 21px; left: 21px; background: rgba(0, 255, 60, 0.9); }

    /* Sniper Scope Overlay */
    #sniper-scope {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: none;
      pointer-events: none;
    }
    .scope-vignette {
      position: absolute;
      width: 82vh;
      height: 82vh;
      box-shadow: inset 0 0 0 100vmax rgba(0, 0, 0, 0.98);
      border-radius: 50%;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      border: 3px solid rgba(25, 25, 25, 0.95);
    }
    .scope-line-h {
      position: absolute;
      top: 50%;
      left: 0;
      width: 100%;
      height: 1px;
      background: rgba(0, 0, 0, 0.95);
    }
    .scope-line-v {
      position: absolute;
      left: 50%;
      top: 0;
      width: 1px;
      height: 100%;
      background: rgba(0, 0, 0, 0.95);
    }
    .scope-center-dot {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 4px;
      height: 4px;
      background: rgba(255, 20, 20, 0.9);
      border-radius: 50%;
    }

    /* Radar / Minimap */
    #radar-wrapper {
      position: absolute;
      top: 20px;
      left: 20px;
      width: 150px;
      height: 150px;
      background: rgba(10, 20, 10, 0.7);
      border: 2px solid rgba(80, 200, 80, 0.75);
      border-radius: 50%;
      overflow: hidden;
      box-shadow: 0 0 10px rgba(0,0,0,0.8);
    }
    #radar-canvas {
      width: 100%;
      height: 100%;
    }

    /* Killfeed */
    #killfeed {
      position: absolute;
      top: 20px;
      right: 20px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      pointer-events: none;
      align-items: flex-end;
    }
    .kill-entry {
      background: rgba(15, 18, 20, 0.9);
      padding: 6px 14px;
      border-radius: 4px;
      font-size: 14px;
      font-weight: bold;
      border-left: 3px solid #ffcc00;
      animation: killFade 5s forwards;
      text-shadow: 1px 1px 2px #000;
    }
    .team-ct { color: #5dade2; font-weight: bold; }
    .team-t { color: #e74c3c; font-weight: bold; }
    .hs-icon { color: #ff3333; font-size: 12px; margin-left: 6px; background: rgba(255,0,0,0.2); padding: 1px 4px; border-radius: 2px; }
    @keyframes killFade {
      0% { opacity: 0; transform: translateX(20px); }
      10% { opacity: 1; transform: translateX(0); }
      80% { opacity: 1; }
      100% { opacity: 0; transform: translateY(-10px); }
    }

    /* Bottom CS HUD Bar */
    .hud-bottom {
      position: absolute;
      bottom: 20px;
      left: 30px;
      right: 30px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      color: #9cdb2b;
      text-shadow: 0 0 6px rgba(156, 219, 43, 0.7), 1px 1px 2px #000;
      font-size: 26px;
      font-weight: 900;
      letter-spacing: 2px;
    }
    .hud-box {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(0, 0, 0, 0.55);
      padding: 8px 18px;
      border-radius: 6px;
      border: 1px solid rgba(156, 219, 43, 0.4);
    }
    .hud-icon {
      font-size: 24px;
    }
    .hud-val {
      font-size: 32px;
      font-family: 'Courier New', monospace;
    }

    #money-display {
      color: #38ef7d;
      font-size: 28px;
      text-shadow: 0 0 8px rgba(56, 239, 125, 0.7);
      margin-bottom: 8px;
      font-weight: bold;
    }

    /* Damage indicator flash */
    #damage-flash {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle, transparent 55%, rgba(255, 0, 0, 0.65) 100%);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.15s ease-out;
      z-index: 15;
    }

    /* Round Banner Announcement */
    #round-banner {
      position: absolute;
      top: 25%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 38px;
      font-weight: 900;
      text-align: center;
      color: #ffd700;
      text-shadow: 0 0 15px rgba(0,0,0,0.9), 2px 2px 4px #000;
      letter-spacing: 3px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      z-index: 25;
    }

    /* Hitmarker */
    #hitmarker {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 24px;
      height: 24px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.08s ease-out;
    }
    .hm-line {
      position: absolute;
      background: #ff3333;
      box-shadow: 0 0 4px #ff0000;
    }
    .hm-tl { width: 7px; height: 2px; top: 3px; left: 3px; transform: rotate(45deg); }
    .hm-tr { width: 7px; height: 2px; top: 3px; right: 3px; transform: rotate(-45deg); }
    .hm-bl { width: 7px; height: 2px; bottom: 3px; left: 3px; transform: rotate(-45deg); }
    .hm-br { width: 7px; height: 2px; bottom: 3px; right: 3px; transform: rotate(45deg); }

    /* Modals & Menus (CS 1.6 Style) */
    .menu-modal {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: rgba(18, 24, 20, 0.96);
      border: 2px solid #6b8c42;
      border-radius: 8px;
      box-shadow: 0 0 35px rgba(0, 0, 0, 0.85), inset 0 0 12px rgba(107, 140, 66, 0.3);
      padding: 26px 36px;
      color: #e5e5e5;
      z-index: 50;
      max-width: 620px;
      width: 90%;
    }

    .menu-title {
      color: #c4d936;
      font-size: 24px;
      font-weight: bold;
      text-align: center;
      margin-bottom: 20px;
      letter-spacing: 2px;
      border-bottom: 1px solid #4a632b;
      padding-bottom: 10px;
      text-shadow: 0 0 6px rgba(196, 217, 54, 0.6);
    }

    /* Buy Menu */
    #buy-menu {
      display: none;
    }
    .buy-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 16px;
    }
    .buy-btn {
      background: rgba(30, 45, 30, 0.85);
      border: 1px solid #5a7d32;
      color: #fff;
      padding: 12px 14px;
      border-radius: 4px;
      cursor: pointer;
      text-align: left;
      font-family: inherit;
      transition: all 0.15s;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .buy-btn:hover {
      background: #466922;
      border-color: #8bb342;
      transform: scale(1.02);
    }
    .buy-btn .price {
      color: #55ff55;
      font-weight: bold;
    }

    /* Start / Pause Menu */
    #pause-menu {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .cs-btn {
      background: #415e21;
      border: 2px solid #7ea83c;
      color: #fff;
      font-size: 18px;
      font-weight: bold;
      padding: 12px 32px;
      border-radius: 6px;
      cursor: pointer;
      margin: 10px 0;
      letter-spacing: 1px;
      transition: 0.2s;
      box-shadow: 0 4px 10px rgba(0,0,0,0.5);
      font-family: inherit;
    }
    .cs-btn:hover {
      background: #5b852e;
      border-color: #a7dc52;
      transform: translateY(-2px);
    }
    .settings-row {
      display: flex;
      justify-content: space-between;
      width: 100%;
      margin: 10px 0;
      align-items: center;
      font-size: 15px;
    }
    .settings-row input[type="range"] {
      width: 140px;
      accent-color: #7ea83c;
    }
    .controls-hint {
      margin-top: 15px;
      font-size: 13px;
      color: #a0a0a0;
      line-height: 1.6;
      background: rgba(0,0,0,0.45);
      padding: 12px;
      border-radius: 4px;
      width: 100%;
    }
    .key-badge {
      background: #2a3820;
      border: 1px solid #5a7d32;
      padding: 2px 6px;
      border-radius: 3px;
      color: #c4d936;
      font-weight: bold;
    }

    /* Scoreboard */
    #scoreboard {
      display: none;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 740px;
      background: rgba(12, 16, 14, 0.95);
      border: 2px solid #536e2d;
      border-radius: 6px;
      box-shadow: 0 0 35px rgba(0,0,0,0.9);
      padding: 20px;
      z-index: 60;
    }
    .sb-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }
    .sb-table th, .sb-table td {
      padding: 8px 12px;
      text-align: left;
      font-size: 14px;
    }
    .sb-table th {
      background: rgba(25, 35, 20, 0.85);
      color: #92b842;
      border-bottom: 2px solid #536e2d;
    }
    .sb-row-ct {
      border-bottom: 1px solid rgba(93, 173, 226, 0.2);
    }
    .sb-row-t {
      border-bottom: 1px solid rgba(231, 76, 60, 0.2);
    }
    .status-dead {
      color: #777 !important;
      text-decoration: line-through;
    }
  </style>
</head>
<body>

<div id="game-container">
  <canvas id="c"></canvas>

  <!-- HUD -->
  <div id="hud">
    <!-- Crosshair -->
    <div id="crosshair">
      <div class="ch-bar" id="ch-top"></div>
      <div class="ch-bar" id="ch-bottom"></div>
      <div class="ch-bar" id="ch-left"></div>
      <div class="ch-bar" id="ch-right"></div>
      <div id="ch-dot"></div>
    </div>

    <!-- Hitmarker -->
    <div id="hitmarker">
      <div class="hm-line hm-tl"></div>
      <div class="hm-line hm-tr"></div>
      <div class="hm-line hm-bl"></div>
      <div class="hm-line hm-br"></div>
    </div>

    <!-- Sniper Scope -->
    <div id="sniper-scope">
      <div class="scope-vignette"></div>
      <div class="scope-line-h"></div>
      <div class="scope-line-v"></div>
      <div class="scope-center-dot"></div>
    </div>

    <!-- Radar / Minimap -->
    <div id="radar-wrapper">
      <canvas id="radar-canvas" width="150" height="150"></canvas>
    </div>

    <!-- Killfeed -->
    <div id="killfeed"></div>

    <!-- Damage Screen Flash -->
    <div id="damage-flash"></div>

    <!-- Round Banner -->
    <div id="round-banner">ROUND START</div>

    <!-- Bottom HUD stats -->
    <div class="hud-bottom">
      <div style="display: flex; gap: 15px;">
        <div class="hud-box">
          <span class="hud-icon">+</span>
          <span class="hud-val" id="hud-hp">100</span>
        </div>
        <div class="hud-box">
          <span class="hud-icon">🛡️</span>
          <span class="hud-val" id="hud-armor">100</span>
        </div>
      </div>

      <div class="hud-box" style="font-size: 28px;">
        <span class="hud-icon">⏱️</span>
        <span class="hud-val" id="hud-timer">02:00</span>
      </div>

      <div style="display: flex; flex-direction: column; align-items: flex-end;">
        <div id="money-display">$<span id="hud-money">16000</span></div>
        <div class="hud-box">
          <span id="hud-weapon-name" style="font-size: 16px; margin-right: 10px; color: #ffeb3b;">AK-47</span>
          <span class="hud-val" id="hud-ammo">30</span>
          <span style="font-size: 20px; color: #888;">/</span>
          <span style="font-size: 22px; color: #aaa;" id="hud-reserve">90</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Buy Menu (B Key) -->
  <div class="menu-modal" id="buy-menu">
    <div class="menu-title">🛒 QOROL VA ASLAHALAR DO'KONI (B)</div>
    <div class="buy-grid">
      <button class="buy-btn" onclick="buyWeapon('ak47')">
        <span>1. AK-47 (Avtomat)</span>
        <span class="price">$2700</span>
      </button>
      <button class="buy-btn" onclick="buyWeapon('m4a1')">
        <span>2. M4A1 (Shturm miltiq)</span>
        <span class="price">$3100</span>
      </button>
      <button class="buy-btn" onclick="buyWeapon('awp')">
        <span>3. AWP (Snayper)</span>
        <span class="price">$4750</span>
      </button>
      <button class="buy-btn" onclick="buyWeapon('deagle')">
        <span>4. Desert Eagle (To'pponcha)</span>
        <span class="price">$650</span>
      </button>
      <button class="buy-btn" onclick="buyEquipment('kevlar')">
        <span>5. Bronjilet + Shlem</span>
        <span class="price">$1000</span>
      </button>
      <button class="buy-btn" onclick="buyEquipment('grenade')">
        <span>6. HE Grenada (Portlovchi)</span>
        <span class="price">$300</span>
      </button>
      <button class="buy-btn" onclick="buyEquipment('ammo_prim')">
        <span>7. Asosiy o'q (Primary Ammo)</span>
        <span class="price">$100</span>
      </button>
      <button class="buy-btn" onclick="buyEquipment('ammo_sec')">
        <span>8. Pistolet o'qi (Secondary Ammo)</span>
        <span class="price">$50</span>
      </button>
    </div>
    <div style="text-align: center; color: #999; font-size: 13px;">
      [B] yoki [ESC] bosib menyuni yopishingiz mumkin. Tezkor xarid: [1 - 8]
    </div>
  </div>

  <!-- Scoreboard (TAB Key) -->
  <div id="scoreboard">
    <div class="menu-title" style="margin-bottom: 10px;">🏆 JAMOALAR JADVALI (SCOREBOARD)</div>
    <div style="display: flex; justify-content: space-between; font-weight: bold; margin-bottom: 8px;">
      <span class="team-ct">COUNTER-TERRORISTS: <span id="ct-score">0</span></span>
      <span class="team-t">TERRORISTS: <span id="t-score">0</span></span>
    </div>
    <table class="sb-table">
      <thead>
        <tr>
          <th>Jamoa</th>
          <th>O'yinchi</th>
          <th>Kills</th>
          <th>Deaths</th>
          <th>Ping</th>
        </tr>
      </thead>
      <tbody id="scoreboard-body">
        <!-- populated dynamically -->
      </tbody>
    </table>
    <div style="text-align: center; margin-top: 15px; color: #888; font-size: 12px;">
      [TAB] tugmasini qo'yib yuborsangiz jadval yopiladi
    </div>
  </div>

  <!-- Start / Pause Menu -->
  <div class="menu-modal" id="pause-menu">
    <div class="menu-title">⚡ COUNTER-STRIKE 1.6: DUST II ⚡</div>
    <p style="text-align: center; font-size: 14px; margin-bottom: 15px; color: #bbb;">
      Klassik Counter-Strike 1.6: 3D de_dust2 xaritasi, botlar va qurollar bilan!
    </p>

    <button class="cs-btn" id="btn-play">🎮 O'YINNI BOSHLASH</button>

    <div class="settings-row">
      <span>Sichqoncha sezgirligi (Sensitivity):</span>
      <input type="range" id="setting-sens" min="0.2" max="3.0" step="0.1" value="1.0">
    </div>

    <div class="settings-row">
      <span>Ovoz balandligi (Volume):</span>
      <input type="range" id="setting-vol" min="0" max="1" step="0.05" value="0.8">
    </div>

    <div class="settings-row">
      <span>Dushman botlar soni:</span>
      <select id="setting-bots" style="background:#222; color:#fff; border:1px solid #666; padding:4px 8px; border-radius:4px;">
        <option value="3">3 ta Bot</option>
        <option value="5" selected>5 ta Bot (Standart)</option>
        <option value="8">8 ta Bot (Qiyin)</option>
      </select>
    </div>

    <div class="controls-hint">
      <strong>Boshqaruv tugmalari:</strong><br>
      • <span class="key-badge">W A S D</span> — Harakatlanish<br>
      • <span class="key-badge">Sichqoncha</span> — Nishonga olish & Otish (Chap tugma)<br>
      • <span class="key-badge">O'ng tugma</span> — Snayper (AWP) optik nishoni (Zoom)<br>
      • <span class="key-badge">Space</span> — Sakrash (Jump)<br>
      • <span class="key-badge">Shift</span> — Sekin yurish (Ovozsiz qadamlar)<br>
      • <span class="key-badge">Ctrl</span> — O'tirish (Crouch - aniqlik oshadi)<br>
      • <span class="key-badge">R</span> — O'qni qayta to'ldirish (Reload)<br>
      • <span class="key-badge">1 - 4</span> — Qurollarni almashtirish (1: Asosiy, 2: Pistolet, 3: Pichoq, 4: Grenada)<br>
      • <span class="key-badge">B</span> — Quroldozlik do'koni (Buy menu)<br>
      • <span class="key-badge">TAB</span> — Natijalar jadvali (Scoreboard)<br>
      • <span class="key-badge">Space / Enter</span> — Halok bo'lganda raundni darhol qayta boshlash<br>
      • <span class="key-badge">P</span> yoki <span class="key-badge">ESC</span> — Pauza / Sozlamalar
    </div>
  </div>
</div>

<!-- Three.js with fallback -->
<script src="three.min.js"></script>
<script>
  if (typeof THREE === 'undefined') {
    document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"><\/script>');
  }
</script>

<script>
/* ==========================================================================
   COUNTER-STRIKE 1.6: ADVANCED WEB 3D ENGINE
   ========================================================================== */

// --- 1. Audio Engine (Web Audio API Synthesizer) ---
class AudioEngine {
  constructor() {
    this.ctx = null;
    this.masterGain = null;
    this.volume = 0.8;
  }

  init() {
    if (!this.ctx) {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      this.ctx = new AudioContext();
      this.masterGain = this.ctx.createGain();
      this.masterGain.gain.setValueAtTime(this.volume, this.ctx.currentTime);
      this.masterGain.connect(this.ctx.destination);
    }
    if (this.ctx.state === 'suspended') {
      this.ctx.resume();
    }
  }

  setVolume(vol) {
    this.volume = vol;
    if (this.masterGain && this.ctx) {
      this.masterGain.gain.setValueAtTime(vol, this.ctx.currentTime);
    }
  }

  // Gunshots & Slash
  playGunshot(type) {
    if (!this.ctx) return;
    const t = this.ctx.currentTime;

    if (type === 'knife') {
      // Whoosh sound
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(480, t);
      osc.frequency.exponentialRampToValueAtTime(110, t + 0.16);
      gain.gain.setValueAtTime(0.5, t);
      gain.gain.exponentialRampToValueAtTime(0.01, t + 0.16);
      osc.connect(gain);
      gain.connect(this.masterGain);
      osc.start(t);
      osc.stop(t + 0.16);
      return;
    }

    // Noise buffer for blast
    const bufferSize = this.ctx.sampleRate * 0.45;
    const noiseBuffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
    const output = noiseBuffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i++) {
      output[i] = Math.random() * 2 - 1;
    }

    const whiteNoise = this.ctx.createBufferSource();
    whiteNoise.buffer = noiseBuffer;

    const filter = this.ctx.createBiquadFilter();
    const noiseGain = this.ctx.createGain();

    // Bass punch oscillator
    const osc = this.ctx.createOscillator();
    const oscGain = this.ctx.createGain();

    if (type === 'awp') {
      // Thunderous sniper crack
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(3600, t);
      filter.frequency.exponentialRampToValueAtTime(280, t + 0.4);

      noiseGain.gain.setValueAtTime(1.0, t);
      noiseGain.gain.exponentialRampToValueAtTime(0.01, t + 0.45);

      osc.type = 'triangle';
      osc.frequency.setValueAtTime(160, t);
      osc.frequency.exponentialRampToValueAtTime(35, t + 0.35);
      oscGain.gain.setValueAtTime(1.0, t);
      oscGain.gain.exponentialRampToValueAtTime(0.01, t + 0.4);

    } else if (type === 'deagle') {
      // Heavy metallic bang
      filter.type = 'bandpass';
      filter.frequency.setValueAtTime(2200, t);
      filter.Q.value = 1.2;

      noiseGain.gain.setValueAtTime(0.85, t);
      noiseGain.gain.exponentialRampToValueAtTime(0.01, t + 0.22);

      osc.type = 'sine';
      osc.frequency.setValueAtTime(220, t);
      osc.frequency.exponentialRampToValueAtTime(45, t + 0.18);
      oscGain.gain.setValueAtTime(0.8, t);
      oscGain.gain.exponentialRampToValueAtTime(0.01, t + 0.2);

    } else if (type === 'm4a1') {
      // Crisp suppressed/fast crack
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(2800, t);

      noiseGain.gain.setValueAtTime(0.65, t);
      noiseGain.gain.exponentialRampToValueAtTime(0.01, t + 0.14);

      osc.type = 'sine';
      osc.frequency.setValueAtTime(180, t);
      osc.frequency.exponentialRampToValueAtTime(50, t + 0.12);
      oscGain.gain.setValueAtTime(0.6, t);
      oscGain.gain.exponentialRampToValueAtTime(0.01, t + 0.13);

    } else {
      // AK-47: Classic raw metallic punch
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(3200, t);
      filter.frequency.exponentialRampToValueAtTime(380, t + 0.16);

      noiseGain.gain.setValueAtTime(0.8, t);
      noiseGain.gain.exponentialRampToValueAtTime(0.01, t + 0.18);

      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(200, t);
      osc.frequency.exponentialRampToValueAtTime(40, t + 0.14);
      oscGain.gain.setValueAtTime(0.7, t);
      oscGain.gain.exponentialRampToValueAtTime(0.01, t + 0.15);
    }

    whiteNoise.connect(filter);
    filter.connect(noiseGain);
    noiseGain.connect(this.masterGain);

    osc.connect(oscGain);
    oscGain.connect(this.masterGain);

    whiteNoise.start(t);
    whiteNoise.stop(t + 0.45);
    osc.start(t);
    osc.stop(t + 0.45);
  }

  playReload() {
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    this.playClick(t, 600, 0.05);
    this.playClick(t + 0.7, 750, 0.06);
    this.playClick(t + 1.2, 1100, 0.08);
  }

  playClick(time, freq, dur) {
    if (!this.ctx) return;
    const osc = this.ctx.createOscillator();
    const g = this.ctx.createGain();
    osc.type = 'square';
    osc.frequency.setValueAtTime(freq, time);
    osc.frequency.exponentialRampToValueAtTime(freq * 0.4, time + dur);
    g.gain.setValueAtTime(0.3, time);
    g.gain.exponentialRampToValueAtTime(0.01, time + dur);
    osc.connect(g);
    g.connect(this.masterGain);
    osc.start(time);
    osc.stop(time + dur);
  }

  playHit(isHeadshot) {
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    if (isHeadshot) {
      // Crisp metallic ding + headshot bell
      const osc = this.ctx.createOscillator();
      const g = this.ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(1400, t);
      osc.frequency.setValueAtTime(1900, t + 0.05);
      g.gain.setValueAtTime(0.65, t);
      g.gain.exponentialRampToValueAtTime(0.01, t + 0.35);
      osc.connect(g);
      g.connect(this.masterGain);
      osc.start(t);
      osc.stop(t + 0.35);
    } else {
      // Flesh thud
      const osc = this.ctx.createOscillator();
      const g = this.ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(130, t);
      osc.frequency.exponentialRampToValueAtTime(40, t + 0.08);
      g.gain.setValueAtTime(0.4, t);
      g.gain.exponentialRampToValueAtTime(0.01, t + 0.08);
      osc.connect(g);
      g.connect(this.masterGain);
      osc.start(t);
      osc.stop(t + 0.08);
    }
  }

  playFootstep() {
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    const g = this.ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(80, t);
    osc.frequency.exponentialRampToValueAtTime(30, t + 0.05);
    g.gain.setValueAtTime(0.12, t);
    g.gain.exponentialRampToValueAtTime(0.01, t + 0.05);
    osc.connect(g);
    g.connect(this.masterGain);
    osc.start(t);
    osc.stop(t + 0.05);
  }

  playExplosion() {
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    const bufferSize = this.ctx.sampleRate * 0.9;
    const noiseBuffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
    const data = noiseBuffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;

    const noise = this.ctx.createBufferSource();
    noise.buffer = noiseBuffer;
    const filter = this.ctx.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.setValueAtTime(900, t);
    filter.frequency.exponentialRampToValueAtTime(50, t + 0.9);

    const gain = this.ctx.createGain();
    gain.gain.setValueAtTime(1.0, t);
    gain.gain.exponentialRampToValueAtTime(0.01, t + 0.9);

    noise.connect(filter);
    filter.connect(gain);
    gain.connect(this.masterGain);
    noise.start(t);
    noise.stop(t + 0.9);
  }

  playRadio(text) {
    if ('speechSynthesis' in window) {
      try {
        const u = new SpeechSynthesisUtterance(text);
        u.volume = this.volume;
        u.pitch = 0.9;
        u.rate = 1.1;
        window.speechSynthesis.speak(u);
      } catch (e) {}
    }
  }
}

const audio = new AudioEngine();

// --- 2. Procedural Canvas Textures (Dust II Theme) ---
const TextureGenerator = {
  createCrateTexture() {
    const canvas = document.createElement('canvas');
    canvas.width = 256;
    canvas.height = 256;
    const ctx = canvas.getContext('2d');

    // Base wood
    ctx.fillStyle = '#9b7145';
    ctx.fillRect(0, 0, 256, 256);

    // Wood planks
    for (let y = 0; y < 256; y += 32) {
      ctx.fillStyle = (y / 32) % 2 === 0 ? '#8a623a' : '#a87d4f';
      ctx.fillRect(0, y, 256, 30);
      ctx.fillStyle = '#5c4024';
      ctx.fillRect(0, y + 30, 256, 2);
    }

    // Diagonal and frame braces
    ctx.strokeStyle = '#543b22';
    ctx.lineWidth = 14;
    ctx.strokeRect(7, 7, 242, 242);

    ctx.beginPath();
    ctx.moveTo(10, 10);
    ctx.lineTo(246, 246);
    ctx.stroke();

    // Stencil text
    ctx.fillStyle = 'rgba(20, 20, 20, 0.7)';
    ctx.font = 'bold 24px Courier New';
    ctx.textAlign = 'center';
    ctx.fillText('CS 1.6', 128, 110);
    ctx.font = 'bold 16px Courier New';
    ctx.fillText('FRAGILE', 128, 140);

    const tex = new THREE.CanvasTexture(canvas);
    tex.wrapS = THREE.RepeatWrapping;
    tex.wrapT = THREE.RepeatWrapping;
    return tex;
  },

  createWallTexture() {
    const canvas = document.createElement('canvas');
    canvas.width = 256;
    canvas.height = 256;
    const ctx = canvas.getContext('2d');

    ctx.fillStyle = '#c7ab77';
    ctx.fillRect(0, 0, 256, 256);

    const rows = 8;
    const blockH = 256 / rows;
    for (let r = 0; r < rows; r++) {
      const y = r * blockH;
      const offset = (r % 2) * 32;
      for (let x = -32; x < 256; x += 64) {
        ctx.fillStyle = `rgb(${190 + Math.random()*25}, ${160 + Math.random()*25}, ${115 + Math.random()*20})`;
        ctx.fillRect(x + offset + 2, y + 2, 60, blockH - 4);
      }
      ctx.fillStyle = '#8f764a';
      ctx.fillRect(0, y, 256, 2);
    }

    for (let i = 0; i < 1500; i++) {
      const nx = Math.random() * 256;
      const ny = Math.random() * 256;
      ctx.fillStyle = Math.random() > 0.5 ? 'rgba(0,0,0,0.06)' : 'rgba(255,255,255,0.08)';
      ctx.fillRect(nx, ny, 2, 2);
    }

    const tex = new THREE.CanvasTexture(canvas);
    tex.wrapS = THREE.RepeatWrapping;
    tex.wrapT = THREE.RepeatWrapping;
    return tex;
  },

  createFloorTexture() {
    const canvas = document.createElement('canvas');
    canvas.width = 256;
    canvas.height = 256;
    const ctx = canvas.getContext('2d');

    ctx.fillStyle = '#bfa171';
    ctx.fillRect(0, 0, 256, 256);

    for (let x = 0; x < 256; x += 64) {
      for (let y = 0; y < 256; y += 64) {
        ctx.fillStyle = `rgb(${185 + Math.random()*15}, ${155 + Math.random()*15}, ${110 + Math.random()*15})`;
        ctx.fillRect(x + 2, y + 2, 60, 60);
      }
    }

    for (let i = 0; i < 3000; i++) {
      ctx.fillStyle = Math.random() > 0.5 ? 'rgba(80,60,30,0.08)' : 'rgba(240,220,180,0.12)';
      ctx.fillRect(Math.random() * 256, Math.random() * 256, 2, 2);
    }

    const tex = new THREE.CanvasTexture(canvas);
    tex.wrapS = THREE.RepeatWrapping;
    tex.wrapT = THREE.RepeatWrapping;
    tex.repeat.set(16, 16);
    return tex;
  },

  createDoorTexture() {
    const canvas = document.createElement('canvas');
    canvas.width = 256;
    canvas.height = 256;
    const ctx = canvas.getContext('2d');

    ctx.fillStyle = '#556268';
    ctx.fillRect(0, 0, 256, 256);

    ctx.strokeStyle = '#323d42';
    ctx.lineWidth = 6;
    ctx.strokeRect(10, 10, 236, 110);
    ctx.strokeRect(10, 130, 236, 116);

    ctx.fillStyle = '#8da2ac';
    for (let x = 20; x < 240; x += 40) {
      ctx.beginPath(); ctx.arc(x, 18, 3, 0, Math.PI * 2); ctx.fill();
      ctx.beginPath(); ctx.arc(x, 115, 3, 0, Math.PI * 2); ctx.fill();
      ctx.beginPath(); ctx.arc(x, 138, 3, 0, Math.PI * 2); ctx.fill();
      ctx.beginPath(); ctx.arc(x, 238, 3, 0, Math.PI * 2); ctx.fill();
    }

    const tex = new THREE.CanvasTexture(canvas);
    return tex;
  },

  createSiteDecal(letter) {
    const canvas = document.createElement('canvas');
    canvas.width = 128;
    canvas.height = 128;
    const ctx = canvas.getContext('2d');

    ctx.clearRect(0, 0, 128, 128);
    ctx.strokeStyle = 'rgba(220, 20, 20, 0.85)';
    ctx.lineWidth = 8;
    ctx.beginPath();
    ctx.arc(64, 64, 52, 0, Math.PI * 2);
    ctx.stroke();

    ctx.fillStyle = 'rgba(220, 20, 20, 0.9)';
    ctx.font = '900 64px Impact, Arial';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(letter, 64, 68);

    return new THREE.CanvasTexture(canvas);
  }
};

